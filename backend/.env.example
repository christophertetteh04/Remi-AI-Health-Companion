PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# AI providers: you do not need every key configured. The AI provider
# router skips providers whose API key is not set.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_CHECKINS_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
AI_PROVIDER_PRIORITY_TEXT=gemini,anthropic,openai,deepseek,kimi
AI_PROVIDER_PRIORITY_VISION=gemini,anthropic,openai,kimi
# Keep this manually verified and narrower than the general chains.
# Do not add providers here until they have been tested against Remi's
# non-diagnostic and danger-sign safety instructions.
AI_PROVIDER_PRIORITY_SAFETY_CRITICAL=

POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
REMI_CORS_ORIGINS=http://localhost:19006,http://localhost:8081
ADMIN_API_KEY=choose-a-long-random-string-here
SENTRY_DSN=

# Optional admin alerts for AI provider failures. Sentry receives these
# automatically when SENTRY_DSN is configured. Add either a webhook, or
# Resend email settings, or both.
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_FROM_EMAIL=Remi Alerts <alerts@your-domain.com>
RESEND_API_KEY=

ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
GOOGLE_PLACES_API_KEY=your-google-places-api-key
